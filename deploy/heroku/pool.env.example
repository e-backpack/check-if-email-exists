# Copy to ~/.config/reacher/pool.env (chmod 600). Never commit the real file.
# Heroku app names of the pool (space separated). One web dyno per app = one outbound IP per app.
APPS="pnda-reacher-us-1 pnda-reacher-us-2"
# Must be us: outbound port 25 is blocked in the eu region (SMTP checks time out).
REGION=us
# Heroku team owning the apps (billing). Empty = personal account.
TEAM=pnda
# SMTP identity (needs the DNS records described in README.md: A + SPF on the HELO name).
# Empty = temporary identity = each app's own <app>-xxxx.herokuapp.com host (resolves, no DNS to create).
# Final value once the client's domain is known, e.g. HELLO_NAME=reacher.<domain> FROM_EMAIL=verify@reacher.<domain>
HELLO_NAME=
FROM_EMAIL=
# Shared secret checked by Reacher in the x-reacher-secret header. Kept in its own file.
SECRET_FILE="$HOME/.config/reacher/header_secret"
